{
  "name": "RemiSoft - Express + React",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [3000, 3306, 5173],
  "portsAttributes": {
    "3000": {
      "label": "Express API + Prisma",
      "onAutoForward": "silent",
      "visibility": "private"
    },
    "5173": {
      "label": "React/Vite",
      "onAutoForward": "silent",
      "visibility": "private"
    },
    "3306": {
      "label": "MariaDB",
      "onAutoForward": "ignore",
      "visibility": "private"
    }
  },
  "postCreateCommand": "corepack enable && corepack prepare pnpm@10.15.0 --activate && bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "dsznajder.es7-react-js-snippets",
        "bradlc.vscode-tailwindcss",
        "eamodio.gitlens",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-mysql",
        "PKief.material-icon-theme",
        "Prisma.prisma"
      ]
    }
  }
}