# Variables de entorno de RemiSoft.
# Copia este archivo como .env en la raíz del repositorio y completa los valores.
#   Copy-Item .env.example .env        (PowerShell)
# El archivo .env está ignorado por git: nunca lo subas.
#
# Generar los dos secretos (PowerShell, 64 caracteres hexadecimales cada uno):
#   -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })
# O con OpenSSL:
#   openssl rand -hex 32
#
# docker compose falla a propósito si DB_ROOT_PASSWORD, DB_PASSWORD o JWT_SECRET
# quedan vacíos: no hay valores por defecto en el repositorio.

# --- MariaDB ---------------------------------------------------------------
# Contraseña de root del contenedor de MariaDB (obligatoria).
DB_ROOT_PASSWORD=
# Contraseña del usuario remisoft de MariaDB (obligatoria).
DB_PASSWORD=

# --- Backend ---------------------------------------------------------------
# Obligatorio, mínimo 32 caracteres. El backend no arranca sin él.
JWT_SECRET=
# Tiempo de vida del token. 8h reduce la ventana de un token robado.
JWT_EXPIRES_IN=8h
# 1 carga los usuarios demo (clave 123456) en una base vacía. Usar 0 siempre
# salvo en un entorno de práctica aislado.
CARGAR_DEMO=0
# Origen permitido por CORS. En Docker con nginx es http://localhost
FRONTEND_URL=http://localhost

# --- Correo (Mailtrap / SMTP) ---------------------------------------------
# Los nombres deben coincidir con docker-compose.yml y con el backend.
MAILTRAP_HOST=smtp.mailtrap.io
MAILTRAP_PORT=587
MAILTRAP_USERNAME=
MAILTRAP_PASSWORD=
MAILTRAP_FROM=noreply@tudominio.local
