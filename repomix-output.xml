                  </div>
                </section>
                <aside className="wa-feed-panel">
                  <div className="wa-feed-panel__header">
                    <h2>Cocina</h2>
                    <span className="material-symbols-outlined wa-feed-panel__icon">restaurant</span>
                  </div>
