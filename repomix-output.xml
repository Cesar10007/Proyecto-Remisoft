                    {feedItems.map((item) => (
                      <div key={`${item.status}-${item.time}`} className={`wa-feed-item wa-feed-item--${item.tone}`}>
                        <div className="wa-feed-item__top">
                          <span className={`wa-feed-item__status wa-feed-item__status--${item.tone}`}>{item.status}</span>
