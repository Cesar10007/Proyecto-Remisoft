# Variables exclusivas del ambiente de pruebas QA.
# Copiar este archivo a .env.qa y generar credenciales privadas.
# No utilizar credenciales de desarrollo o produccion.

# Base de datos independiente
QA_DB_ROOT_PASSWORD=
QA_DB_PASSWORD=

# Secreto JWT exclusivo de QA (minimo 32 caracteres)
QA_JWT_SECRET=

# Direccion del frontend de pruebas
QA_FRONTEND_URL=http://localhost:8080